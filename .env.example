# Public canonical origin. Set to the deployed HTTPS origin in production.
APP_URL=http://localhost:3000
# Supabase transaction/session pooler URL; keep server-side only.
DATABASE_URL=
# Explicit local-only PostgreSQL (PGlite) mode; never use on serverless hosting.
LOCAL_DATABASE=1
# Set a random 32+ character secret in production.
VOTER_SECRET=local-development-only-change-before-deploying
